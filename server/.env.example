# Copy to .env and fill in values
PORT=5000
NODE_ENV=development

# Local MongoDB:   mongodb://127.0.0.1:27017/floral_studio
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/floral_studio
MONGODB_URI=mongodb://127.0.0.1:27017/floral_studio

# JWT auth - use a long random string, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Front-end origin(s) allowed by CORS, comma separated (the separate client app)
CLIENT_URL=http://localhost:5173
